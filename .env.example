# Copy to .env and fill in. docker-compose reads this automatically.

# --- Required ---------------------------------------------------------------

# TMDB API key (v3 auth). Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Your Plex server, reachable from the container. Local is fine, e.g.:
#   http://192.168.1.10:32400
PLEX_URL=
# A Plex token with access to that server (for library enrichment only).
# See https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

# The machineIdentifier of YOUR Plex server. This is the authorization signal:
# only Plex accounts with access to this server can log in.
# Find it at: http://<PLEX_URL>/identity  (the "machineIdentifier" field),
# or in https://plex.tv/api/v2/resources with your token.
PLEX_MACHINE_ID=

# A stable UUID identifying this app to Plex during OAuth. Generate once, e.g.:
#   python -c "import uuid; print(uuid.uuid4())"
# If left blank, the app generates and persists one under /data/client_id.
PLEX_CLIENT_ID=

# Public URL where this app is reached. Used as the OAuth callback target, so it
# MUST match how you actually open the app in a browser, e.g.:
#   http://192.168.1.10:8000   or   https://filmclub.example.com
APP_URL=http://localhost:8000

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Long random secret embedded in the Plex webhook URL. Required for Plex ->
# Film Club rating sync. Generate once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then add this webhook in Plex:
#   https://your-filmclub.example.com/api/plex/webhook/<this value>
# PLEX_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------

# Comma-separated Plex account uuids that are always admins (owner accounts).
# These can access the admin panel, can't be locked out, and survive a DB reset.
# Additional admins can be granted in-app; those are stored in the database.
# ADMIN_PLEX_IDS=622f9388bc1b8ed6

# Skip Plex OAuth and log in as this username (development only). Leave unset in
# production — when set, ANYONE reaching the app is logged in as this user.
# DEV_BYPASS_USER=Alice

# Seconds between Plex library refreshes (default 3600).
# PLEX_REFRESH_INTERVAL=3600

# --- Seerr auto-request (optional) ------------------------------------------
# When set, adding a film that isn't already on your Plex server automatically
# submits a request to your Seerr (Overseerr/Jellyseerr) instance so it gets
# fetched. Leave both blank to disable — the add-to-backlog flow is unchanged.
#
# Base URL of your Seerr instance, reachable from the container, e.g.:
#   http://your-unraid-host.local:5055
# SEERR_URL=
# A Seerr API key. In Seerr: Settings → General → API Key.
# SEERR_API_KEY=
# Per-request timeout in seconds (default 10). Seerr calls never block the add.
# SEERR_TIMEOUT=10
