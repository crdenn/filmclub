# Machine-specific deploy settings for deploy-from-mac.sh.
# Copy this file to deploy.env and fill in your own values:
#     cp deploy.env.example deploy.env
# deploy.env is gitignored, so your real host/URL never land in the repo.
# Every value here is optional; anything you leave unset falls back to the
# generic default baked into deploy-from-mac.sh.

# Hostname or LAN IP of your Unraid box (as reachable over SSH from this Mac).
UNRAID_HOST=your-unraid-host.local

# SSH login user and port on that box.
UNRAID_USER=root
UNRAID_SSH_PORT=22

# Where the app's appdata lives on the server.
FILMCLUB_REMOTE_DIR=/mnt/user/appdata/filmclub

# Public URL the app is served at — used only for the final "deployment
# complete" message.
FILMCLUB_PUBLIC_URL=https://your-filmclub.example.com
